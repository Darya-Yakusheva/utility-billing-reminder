    {
      "parameters": {
        "jsCode": "// Extract email ID from Gmail trigger\nconst emailId = $('Gmail Trigger').first().json.id || $('Gmail Trigger').first().json.messageId || \"Not found\";\n\n// Extract text from the previous node\nconst rawText = $input.item.json.text || $input.item.json.data || \"\";\n\n// Define regular expressions for search (in JS they are enclosed in slashes)\nconst amountRegex = /(\\d{1,3},\\d{2})\\s*€\\s*Valor a Pagar/;\nconst dueDateRegex = /(\\d{4}-\\d{2}-\\d{2})\\s*Pagar até/;\nconst billingPeriodRegex = /Período Faturação:\\s*(\\d{4}-\\d{2}-\\d{2} ~ \\d{4}-\\d{2}-\\d{2})/;\nconst meterReadingWindowRegex = /(\\d{4}-\\d{2}-\\d{2} ~ \\d{4}-\\d{2}-\\d{2})\\s*Período de Comunicação/;\n\n// Search for matches in the raw text and immediately extract data or set to \"Not found\"\nconst amount = rawText.match(amountRegex)?.[1] || \"Not found\";\nconst dueDate = rawText.match(dueDateRegex)?.[1] || \"Not found\";\nconst billingPeriod = rawText.match(billingPeriodRegex)?.[1] || \"Not found\";\nconst meterReadingWindow = rawText.match(meterReadingWindowRegex)?.[1] || \"Not found\";\n\n// Calculate billing month if billing period was found\nconst billingMonth = billingPeriod !== \"Not found\" ? new Date(billingPeriod.slice(0, 7)).toLocaleString('en-US', { month: 'long' }) : \"Not found\";\n\n// Format and return the final result\n// If a match is found, extract group 1 [1]; otherwise, return \"Not found\"\nreturn {\n    \"Email ID\": emailId,\n    \"Billing Period\": billingPeriod,\n    \"Billing Month\": billingMonth,\n    \"Amount\": amount,\n    \"Due Date\": dueDate,\n    \"Meter Reading Window\": meterReadingWindow\n};"
      },
